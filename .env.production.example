# ==============================================================================
# Email Management Service (EMS) — Production Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: cp .env.production.example .env
# 2. Generate a secure 32-byte (64 hex characters) master encryption key:
#    openssl rand -hex 32
# 3. Generate a strong API key:
#    openssl rand -base64 32
# 4. Generate a strong PostgreSQL password:
#    openssl rand -hex 16
# 5. Populate your public domain and ACME email for Let's Encrypt TLS.
# ==============================================================================

EMS_ENV=production
EMS_HTTP_ADDR=:8080
EMS_LOG_LEVEL=info
EMS_RATE_LIMIT=120

# Public domain and TLS configuration
EMS_DOMAIN=ems.bariskode.com
ACME_EMAIL=admin@bariskode.com

# Master encryption key (64 hex characters / 32 bytes) for AES-256-GCM
# CRITICAL: Keep this safe and backed up! Losing this key makes encrypted provider tokens unrecoverable.
EMS_MASTER_KEY=your_64_character_hex_master_key_here

# Admin API Key for accessing /api/v1/* endpoints
EMS_API_KEY=your_secure_random_api_key_here

# PostgreSQL Database Configuration
POSTGRES_USER=ems
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=ems

# Optional global Cloudflare API token (if not configured per-account via API)
CLOUDFLARE_API_TOKEN=
